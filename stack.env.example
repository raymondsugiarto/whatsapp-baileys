# Template for the receivable-wa Portainer stack's environment variables.
# Load a filled-in copy under Stacks → receivable-wa → Editor → Environment
# variables, then Update the stack. Never commit a filled-in copy.

# Shared secret: the same value as WHATSAPP_SIDECAR_SECRET in the
# receivable-api stack. A long random string.
WA_SIDECAR_SECRET=

# Where receivable-api listens on the `platform` network.
WA_API_BASE_URL=http://receivable-api:4011

# Database: the service's own database ("whatsapp"), separate from
# receivable's. Tables are created on startup.
WA_DATABASE_HOST=
WA_DATABASE_PORT=5432
WA_DATABASE_USERNAME=
WA_DATABASE_PASSWORD=
WA_DATABASE_DBNAME=whatsapp
WA_DATABASE_SCHEMA=public

# info, debug, warn or error.
WA_LOG_LEVEL=info
