{
  "name": "receivable-wa",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone WhatsApp Web (Baileys) service: link numbers by QR and send/receive messages over a signed HTTP API. Own database.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "copy-auth": "tsx --env-file-if-exists=.env src/copyAuthState.ts"
  },
  "dependencies": {
    "@hapi/boom": "9.1.4",
    "baileys": "6.7.24",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
