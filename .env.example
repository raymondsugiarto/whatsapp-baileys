# receivable-wa (WhatsApp Web service). Copy to .env for `pnpm dev`.
# Port the HTTP API listens on (client systems call it).
WA_PORT=4020
WA_HOST=0.0.0.0
# Shared HMAC secret with the client system (receivable-api: WHATSAPP_SIDECAR_SECRET).
WA_SIDECAR_SECRET=change-me-long-random-string
# Client system base URL: incoming messages and link status are POSTed to
# <this>/api/v1/internal/whatsapp/inbound and /status.
WA_API_BASE_URL=http://localhost:3030
# The service's OWN Postgres database (not a client's). Tables are created
# on startup (src/schema.ts).
WA_DATABASE_URL=postgres://user:password@localhost:5432/whatsapp
# (Docker sets PGHOST/PGUSER/PGPASSWORD/PGDATABASE instead; used when this is empty.)
WA_DATABASE_SCHEMA=public
WA_LOG_LEVEL=info
